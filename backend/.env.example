# Copie para backend/.env e ajuste os valores. O .env real NAO vai para o git.
# Valores abaixo sao apenas exemplos; troque as senhas e o segredo JWT.

# PostgreSQL (usado pelo docker-compose.yml)
POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# Conexao da aplicacao
DB_URL=jdbc:postgresql://localhost:5432/agenda
DB_USER=agenda
DB_PASSWORD=troque-esta-senha-do-banco

# JWT: segredo com pelo menos 32 bytes; expiracao em segundos (86400 = 24 h)
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-bytes
JWT_EXPIRATION=86400

# Senha da conta de demonstracao demo.aluna@ucsal.edu.br (8 a 72 caracteres)
DEMO_PASSWORD=troque-a-senha-da-conta-demo

# Servidor e CORS (o frontend roda em 5173 e o proxy do Vite chama /api)
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173
