# Copie para .env e ajuste. Nenhuma credencial deve ser colocada aqui: variáveis VITE_* vão para o bundle público.

# Vazio = usa o proxy do Vite (/api -> http://localhost:8080). Preencha só para apontar para outra origem.
VITE_API_URL=

# E-mail da conta de demonstração (sintético). A senha NÃO vai aqui: está em DEMO_PASSWORD no backend.
VITE_DEMO_EMAIL=demo.aluna@ucsal.edu.br
